# Copy to .env and fill in as needed. Sentinel runs fully offline with the defaults below.

# --- LLM ---
# Leave ANTHROPIC_API_KEY blank to use the templated fallback (no network calls).
ANTHROPIC_API_KEY=
# Model used for brief + postmortem synthesis. Override to claude-opus-4-8 for higher quality.
SENTINEL_MODEL=claude-sonnet-5

# --- Integrations ---
# When true, all external systems (GitHub, Slack, metrics) use in-repo mock adapters.
SENTINEL_USE_MOCKS=true

# Real-integration credentials (only used when SENTINEL_USE_MOCKS=false).
# GITHUB_TOKEN: read-only PAT (classic "repo:status"/"public_repo", or a
# fine-grained token with Contents: read) for the real GitHub adapter.
# GITHUB_REPO: "owner/repo" the token can read commits/deployments from.
# SLACK_BOT_TOKEN/SLACK_CHANNEL: not wired to a real adapter yet.
GITHUB_TOKEN=
GITHUB_REPO=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# --- Webhook auth ---
# Leave blank to accept unsigned requests on /webhook/alert and /webhook/resolve
# (fine for local dev). Set it to require callers to sign requests with
# HMAC-SHA256 over the raw body, sent as "X-Sentinel-Signature-256: sha256=<hex>".
SENTINEL_WEBHOOK_SECRET=

# --- Persistence ---
# Where incidents are stored (SQLite). Defaults to sentinel.db at the repo
# root (gitignored) if unset -- unlike the credentials above, leave this line
# commented out rather than blank; an empty value resolves to the current
# directory (".") instead of the intended default. Uncomment to override, e.g.
# for a mounted volume path in Docker.
# SENTINEL_DB_PATH=/data/sentinel.db

# --- Runbook retrieval ---
# false (default): heuristic keyword/tag/service scoring, no extra deps.
# true: local sentence-transformer embedding + cosine similarity instead.
# Requires `pip install -e ".[embeddings]"` (pulls in torch -- a large
# download) and downloads the model from Hugging Face on first use.
SENTINEL_USE_EMBEDDINGS=false
# SENTINEL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
